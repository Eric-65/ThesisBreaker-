# Copy to .env.local and fill in. Never commit real values.
# All of these are read on the server only — none use the NEXT_PUBLIC_ prefix.

# Qwen via Bitget's OpenAI-compatible hackathon endpoint.
# Leave the key empty to run in "offline heuristic" mode.
BITGET_QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max
# Thinking tokens are billed as output. Keep false unless you need it.
QWEN_ENABLE_THINKING=false
QWEN_TIMEOUT_MS=45000

# Postgres, e.g. postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Visitors & optional sign-in (Auth.js v5) ---------------------------------
# Sign-in switches on only when AUTH_SECRET, DATABASE_URL and at least one
# provider below are set. Without them the app runs fully anonymously.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Only needed outside Vercel / behind a proxy, e.g. https://thesisbreaker.example.com
AUTH_URL=

# Google sign-in ("Continue with Google"). Create an OAuth client (type: Web
# application) in Google Cloud Console → APIs & Services → Credentials.
#   Authorized redirect URI: https://<your-domain>/api/auth/callback/google
#   Scopes used: openid, email, profile (nothing else is requested).
# AUTH_GOOGLE_ID is the client ID, AUTH_GOOGLE_SECRET the client secret.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic link via Resend (https://resend.com). FROM must be a verified sender.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="ThesisBreaker <login@your-domain.com>"

# Salt for hashing client IPs used as in-memory rate-limit keys (never stored).
# Falls back to AUTH_SECRET when empty.
IP_HASH_SALT=

# --- Invites, community, admin, legal ------------------------------------------
# Origin used in invite links (no trailing slash). Defaults to the live site in
# production and to the current host in development.
SITE_URL=
# Unlocks /admin (user table, internal flag). At least 16 characters; without it
# /admin returns 404. Generate with: openssl rand -hex 24
ADMIN_TOKEN=
# Address shown on /privacy and /terms for deletion requests and questions.
CONTACT_EMAIL=
